{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bello-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Workers AI: free daily allocation, no API key.
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bello-ai",
      "database_id": "83332107-e5dc-41dc-bbf7-b249c7b49c1a",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly wake-up for discovery. How often it really scans is in config/scan.ts.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
